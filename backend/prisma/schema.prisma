generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  OPERATOR
  ADMIN
}

enum ChipStatus {
  ACTIVATED
  DEFECTIVE
}

enum PhoneNumberStatus {
  AVAILABLE
  ALLOCATED
  RESTRICTED
  BANNED
}

enum WhatsappProfileStatus {
  NOT_CREATED
  ACTIVE
}

enum ConnectionType {
  INITIAL
  RECONNECTION
}

enum ConnectionStatus {
  ALLOCATED
  RECONNECTED
  RESTRICTED
  BANNED
}

enum PhoneNumberHistoryType {
  ACTIVATION
  CONNECTION
  STATUS_CHANGE
}

// =========================
// USER
// =========================

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(OPERATOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectionsCreated Connection[]        @relation("ConnectionCreatedBy")
  assignedUrls        UserUrl[]
  chipActivations     ChipActivation[]
  phoneNumberHistory  PhoneNumberHistory[]
}

// =========================
// COMPANY
// =========================

model Company {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  urls        Url[]
  connections Connection[]
}

// =========================
// URL
// =========================

model Url {
  id  Int    @id @default(autoincrement())
  name String
  url  String

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedUsers UserUrl[]
  connections   Connection[]

  @@unique([companyId, name])
  @@unique([companyId, url])
}

// =========================
// USER ↔ URL
// =========================

model UserUrl {
  userId Int
  urlId  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  url  Url  @relation(fields: [urlId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, urlId])
}

// =========================
// CHIP
// =========================

model Chip {
  id     String     @id @default(uuid())
  status ChipStatus

  createdAt DateTime @default(now())

  activations ChipActivation[]
}

// =========================
// CHIP ACTIVATION
// =========================

model ChipActivation {
  id String @id @default(uuid())

  chipId String
  chip   Chip @relation(fields: [chipId], references: [id], onDelete: Restrict)

  phoneNumberId String
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)

  activatedById Int
  activatedBy   User @relation(fields: [activatedById], references: [id], onDelete: Restrict)

  status ChipStatus

  activatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  phoneNumberHistory PhoneNumberHistory[]
}

// =========================
// PHONE NUMBER
// =========================

model PhoneNumber {
  id          String @id @default(uuid())
  phoneNumber String @unique

  status PhoneNumberStatus @default(AVAILABLE)

  whatsappProfileStatus WhatsappProfileStatus @default(NOT_CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activations ChipActivation[]
  connections Connection[]
  history     PhoneNumberHistory[]
}

// =========================
// CELLPHONE
// =========================

model Cellphone {
  id    Int     @id @default(autoincrement())
  name  String?
  model String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots CellphoneSlot[]
}

// =========================
// CELLPHONE SLOT
// =========================

model CellphoneSlot {
  id Int @id @default(autoincrement())

  cellphoneId Int
  cellphone   Cellphone @relation(fields: [cellphoneId], references: [id], onDelete: Cascade)

  slotNumber Int

  connections Connection[]

  createdAt DateTime @default(now())

  @@unique([cellphoneId, slotNumber])
}

// =========================
// CONNECTION
// =========================

model Connection {
  id Int @id @default(autoincrement())

  type   ConnectionType
  status ConnectionStatus @default(ALLOCATED)

  phoneNumberId String
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)

  cellphoneSlotId Int
  cellphoneSlot   CellphoneSlot @relation(fields: [cellphoneSlotId], references: [id], onDelete: Restrict)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  urlId Int
  url   Url @relation(fields: [urlId], references: [id], onDelete: Restrict)

  createdById Int
  createdBy   User @relation("ConnectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phoneNumberHistory PhoneNumberHistory[]
}

// =========================
// PHONE NUMBER HISTORY
// =========================

model PhoneNumberHistory {
  id String @id @default(uuid())

  phoneNumberId String
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  type PhoneNumberHistoryType

  operatorId Int
  operator   User @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  connectionId Int?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  chipActivationId String?
  chipActivation   ChipActivation? @relation(fields: [chipActivationId], references: [id], onDelete: Restrict)

  description String?

  createdAt DateTime @default(now())

  @@index([phoneNumberId, createdAt])
}